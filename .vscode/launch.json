{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Debug Vitest",
			"type": "node",
			"request": "launch",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": ["exec", "vitest", "run", "--inspect-brk", "--no-file-parallelism"],
			"cwd": "${workspaceFolder}",
			"skipFiles": ["<node_internals>/**"]
		}
	]
}
