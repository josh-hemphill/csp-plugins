{
	"typescript.tsdk": "node_modules/typescript/lib",
	"deno.enable": false,
	"editor.linkedEditing": true,
	"files.associations": {
		"*.css": "postcss"
	},
	"material-icon-theme.folders.associations": {
		"locales": "I18n"
	},
	"editor.formatOnSave": true,
	"editor.tabSize": 3,
	"editor.insertSpaces": false,
	"typescript.enablePromptUseWorkspaceTsdk": true,
	"html.format.wrapAttributes": "force-expand-multiline",
	"prettier.enable": false,
	"eslint.enable": false,
	"oxc.enable": true,
	"editor.defaultFormatter": "oxc.oxc-vscode",
	"[javascript]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[javascriptreact]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[typescript]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[json]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[yaml]": {
		"editor.insertSpaces": true,
		"editor.tabSize": 2
	},
	"[markdown]": {
		"editor.insertSpaces": true,
		"editor.tabSize": 2
	},
	"editor.codeActionsOnSave": {
		"source.fixAll.oxc": "explicit",
		"source.organizeImports": "never"
	},
	"explorer.fileNesting.patterns": {
		"*.ts": "${capture}.js",
		"*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
		"*.jsx": "${capture}.js",
		"*.tsx": "${capture}.ts",
		"tsconfig.json": "tsconfig.*.json",
		"auto.imports.d.ts": "auto.*.d.ts",
		"vite.config.*": "*.config.ts, jsconfig*, vitest.config.*, cypress.config.*, playwright.config.*, volar.config.*",
		"package.json": "package-lock.json, pnpm*, .yarnrc*, yarn*, .oxlint*, oxlint*, .oxfmt*, oxfmt*, .prettier*, prettier*, .editorconfig, jsr.json"
	},
	"pnpmCatalogLens.enabled": true,
	"cSpell.import": ["./.vscode/cSpell.json"],
	"vitest.disableWorkspaceWarning": true,
	"vitest.workspaceConfig": "vitest.config.ts"
}
