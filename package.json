{
	"name": "@csp-plugins/monorepo",
	"version": "1.0.0",
	"private": true,
	"description": "A collection of plugins and packages with shared functionality for creating and managing CSP tags, headers, and directives",
	"keywords": [
		"CSP",
		"CSPs",
		"directive",
		"generate",
		"header",
		"html",
		"plugin",
		"security"
	],
	"homepage": "https://github.com/josh-hemphill/csp-plugins#readme",
	"bugs": {
		"url": "https://github.com/josh-hemphill/csp-plugins/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Joshua Hemphill",
		"email": "dev@joshuahemphill.com",
		"url": "https://joshuahemphill.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/josh-hemphill/csp-plugins.git"
	},
	"type": "module",
	"scripts": {
		"build": "pnpm --filter @csp-plugins/typed-directives --filter @csp-plugins/core --filter @csp-plugins/shared --filter @csp-plugins/basic-fscache run build",
		"build:all": "pnpm --filter @csp-plugins/typed-directives --filter @csp-plugins/core --filter @csp-plugins/shared --filter @csp-plugins/basic-fscache --filter @csp-plugins/adapters --filter @csp-plugins/cli --filter @csp-plugins/unplugin run build",
		"test": "vitest run -c vitest.config.ts",
		"test:coverage": "vitest run -c vitest.config.ts --coverage",
		"test:typed-directives": "pnpm --filter @csp-plugins/typed-directives run test::unit",
		"test:core": "pnpm --filter @csp-plugins/core run test::unit",
		"coverage:summary": "tsx scripts/coverage-summary.ts",
		"docs:api": "typedoc",
		"contributors": "tsx scripts/contributors.ts",
		"lint": "oxlint --deny-warnings .",
		"lint:fix": "oxlint --fix .",
		"fmt": "oxfmt .",
		"fmt:check": "oxfmt --check .",
		"lint:markdown": "markdownlint-cli2 \"**/*.md\" \"#**/node_modules\" \"#**/CHANGELOG.md\" --config .markdownlint.json",
		"lint:markdown:fix": "markdownlint-cli2 --fix \"**/*.md\" \"#**/node_modules\" \"#**/CHANGELOG.md\" --config .markdownlint.json",
		"spell": "cspell --config .vscode/cSpell.json --no-progress \"**/*.{ts,md}\"",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"publish:jsr:dry": "pnpm --filter @csp-plugins/typed-directives exec jsr publish --dry-run --allow-dirty",
		"watch:test": "vitest watch -c vitest.config.ts"
	},
	"devDependencies": {
		"@types/node": "catalog:types",
		"@vitest/coverage-v8": "catalog:test",
		"cspell": "catalog:dev",
		"jsr": "catalog:dev",
		"markdownlint-cli2": "catalog:dev",
		"obuild": "catalog:build",
		"oxfmt": "catalog:dev",
		"oxlint": "catalog:dev",
		"tsx": "catalog:dev",
		"typedoc": "catalog:build",
		"typescript": "catalog:build",
		"vitest": "catalog:test"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.4.1",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": ">=22.13.0",
			"onFail": "error"
		}
	},
	"engines": {
		"node": ">=22.13.0"
	},
	"packageManager": "pnpm@12.4.1"
}
