{
	"name": "@csp-plugins/basic-fscache",
	"version": "0.1.0",
	"description": "Basic filesystem cache for CSP plugins",
	"homepage": "https://github.com/josh-hemphill/csp-plugins/packages/basic-fscache#readme",
	"bugs": {
		"url": "https://github.com/josh-hemphill/csp-plugins/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/josh-hemphill/csp-plugins.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "obuild",
		"test": "pnpm run \"/test:/\"",
		"test::unit": "vitest run",
		"watch:test": "vitest run --watch"
	},
	"dependencies": {
		"@csp-plugins/core": "workspace:*"
	},
	"devDependencies": {
		"obuild": "catalog:build",
		"typescript": "catalog:build",
		"vitest": "catalog:test"
	},
	"engines": {
		"node": ">=22.13.0"
	}
}
