{
	"name": "@csp-plugins/cli",
	"type": "module",
	"version": "0.0.0",
	"private": true,
	"main": "dist/cli.mjs",
	"types": "dist/cli.d.ts",
	"bin": {
		"csp-cli": "dist/cli.mjs"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "obuild",
		"dev": "obuild --watch",
		"test": "vitest run",
