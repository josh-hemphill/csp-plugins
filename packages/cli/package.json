		"test:watch": "vitest --watch",
		"test:coverage": "vitest --coverage"
	},
	"dependencies": {
		"@csp-plugins/basic-fscache": "workspace:*",
		"@csp-plugins/core": "workspace:*",
		"@csp-plugins/shared": "workspace:*",
		"@csp-plugins/typed-directives": "workspace:*",
		"@csp-plugins/unplugin": "workspace:*",
		"loglevel": "catalog:logging"
	},
	"devDependencies": {
		"@types/node": "catalog:types",
		"obuild": "catalog:build",
		"tsx": "catalog:dev",
		"typescript": "catalog:build",
		"vitest": "catalog:test"
	}
}
