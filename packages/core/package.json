{
	"name": "@csp-plugins/core",
	"version": "0.1.0",
	"description": "Core utilities for CSP plugins",
	"homepage": "https://github.com/josh-hemphill/csp-plugins/packages/core#readme",
	"bugs": {
		"url": "https://github.com/josh-hemphill/csp-plugins/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/josh-hemphill/csp-plugins.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "obuild",
		"test": "vitest run",
		"test::unit": "vitest run",
		"watch:test": "vitest run --watch"
	},
	"dependencies": {
		"@csp-plugins/typed-directives": "workspace:*",
		"dom-serializer": "catalog:parsing",
		"domhandler": "catalog:parsing",
		"domutils": "catalog:parsing",
		"htmlparser2": "catalog:parsing"
	},
	"devDependencies": {
		"obuild": "catalog:build",
		"oxlint": "catalog:dev",
		"typescript": "catalog:build",
		"vitest": "catalog:test"
	},
	"engines": {
		"node": ">=22.13.0"
	}
}
