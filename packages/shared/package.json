			"types": "./dist/types.d.mts",
			"import": "./dist/types.mjs"
		},
		"./asset-tracker": {
			"types": "./dist/asset-tracker.d.mts",
			"import": "./dist/asset-tracker.mjs"
		},
		"./manifest-writer": {
			"types": "./dist/manifest-writer.d.mts",
