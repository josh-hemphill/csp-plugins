{
	"name": "@csp-plugins/typed-directives",
	"version": "0.1.0",
	"description": "Provides type information for all CSP directives and related headers' directives; as well as a basic utility funtion that helps convert the typed properties to the header content's policy string.",
	"keywords": [
		"CSP",
		"CSPs",
		"content-security-policy",
		"directive",
		"generate",
		"header",
		"security",
		"types",
		"typescript"
	],
	"homepage": "https://github.com/josh-hemphill/csp-plugins/tree/main/packages/typed-directives#readme",
	"bugs": {
		"url": "https://github.com/josh-hemphill/csp-plugins/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Joshua Hemphill",
		"email": "jhemphill@tecnicocorp.com",
		"url": "https://joshuahemphill.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/josh-hemphill/csp-plugins.git",
		"directory": "packages/typed-directives"
	},
	"files": [
		"CHANGELOG.md",
		"LICENSE",
		"README.md",
		"dist"
	],
	"type": "module",
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./csp.types": {
			"types": "./dist/csp.types.d.mts",
			"import": "./dist/csp.types.mjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "obuild --watch",
		"build": "obuild",
		"lint": "oxlint .",
		"test": "vitest run -c vitest.config.ts",
		"test::unit": "vitest run -c vitest.config.ts",
		"watch:test": "vitest watch -c vitest.config.ts"
	},
	"devDependencies": {
		"@types/node": "catalog:types",
		"obuild": "catalog:build",
		"oxlint": "catalog:dev",
		"typescript": "catalog:build",
		"vitest": "catalog:test"
	},
	"engines": {
		"node": ">=22.13.0"
	}
}
