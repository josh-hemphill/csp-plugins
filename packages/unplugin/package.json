{
	"name": "@csp-plugins/unplugin",
	"version": "0.1.0",
	"description": "Individual build tool plugins for CSP asset tracking and dev server integration",
	"keywords": [
		"CSP",
		"CSPs",
		"asset-tracking",
		"content-security-policy",
		"dev-server",
		"directive",
		"esbuild",
		"generate",
		"header",
		"nuxt",
		"rollup",
		"security",
		"transform",
		"unplugin",
		"vite",
		"webpack"
	],
	"homepage": "https://github.com/josh-hemphill/csp-plugins/tree/main/packages/unplugin#readme",
	"bugs": {
		"url": "https://github.com/josh-hemphill/csp-plugins/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/josh-hemphill/csp-plugins.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./vite": {
			"types": "./dist/vite.d.mts",
			"import": "./dist/vite.mjs"
		},
		"./webpack": {
			"types": "./dist/webpack.d.mts",
			"import": "./dist/webpack.mjs"
		},
		"./rollup": {
			"types": "./dist/rollup.d.mts",
			"import": "./dist/rollup.mjs"
		},
		"./esbuild": {
			"types": "./dist/esbuild.d.mts",
			"import": "./dist/esbuild.mjs"
		},
		"./nuxt": {
			"types": "./dist/nuxt.d.mts",
			"import": "./dist/nuxt.mjs"
		}
	},
	"scripts": {
		"build": "obuild",
		"dev": "obuild --watch",
		"lint": "oxlint .",
		"play": "pnpm -C playground run dev",
		"prepublishOnly": "pnpm run build",
		"test": "vitest run",
		"watch:test": "vitest run --watch"
	},
	"dependencies": {
		"@csp-plugins/basic-fscache": "workspace:*",
		"@csp-plugins/core": "workspace:*",
		"@csp-plugins/shared": "workspace:*",
		"@csp-plugins/typed-directives": "workspace:*",
		"unplugin": "catalog:plugin-systems"
	},
	"devDependencies": {
		"@types/node": "catalog:types",
		"esbuild": "catalog:plugin-systems",
		"oxlint": "catalog:dev",
		"rollup": "catalog:plugin-systems",
		"typescript": "catalog:build",
		"vite": "catalog:plugin-systems",
		"vitest": "catalog:test",
		"webpack": "catalog:plugin-systems"
	},
	"peerDependencies": {
		"esbuild": "^0.28.0",
		"rollup": "^4.0.0",
		"vite": "^8.0.0",
		"webpack": "^5.0.0"
	}
}
