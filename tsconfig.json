{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["esnext"],
		"rootDir": ".",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"types": ["vitest", "node"],
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"noUncheckedSideEffectImports": true,
		"stableTypeOrdering": true,
		"strict": true,
		"strictFunctionTypes": true,
		"strictNullChecks": true,
		"noUnusedLocals": true,
		"declaration": true,
		"emitDeclarationOnly": true,
		"noEmitOnError": true,
		"outDir": "dist",
		"sourceMap": true,
		"esModuleInterop": true,
		"skipDefaultLibCheck": true,
		"skipLibCheck": true
	},
	"include": ["packages", "scripts", "monup.config.ts"],
	"exclude": [
		"node_modules",
		"**/**/*.stories.tsx",
		"**/**/*.md",
		"**/dist",
		"packages/.test",
		"packages/_docs",
		"packages/cli",
		"packages/e2e-tests",
		"packages/unplugin"
	]
}
